{
  "name": "opencode-excel-addin",
  "version": "1.2.0",
  "private": true,
  "description": "OpenCode Excel add-in for workbook analysis, formulas, dashboards, and reviewable Office.js automation",
  "keywords": [
    "opencode",
    "excel",
    "excel-addin",
    "office-js",
    "microsoft-excel",
    "spreadsheet-automation",
    "ai-assistant",
    "data-analysis",
    "excel-formulas"
  ],
  "homepage": "https://github.com/analystsandeep/Openclode-Excel-Addon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analystsandeep/Openclode-Excel-Addon.git"
  },
  "bugs": {
    "url": "https://github.com/analystsandeep/Openclode-Excel-Addon/issues"
  },
  "scripts": {
    "dev": "node bridge/server.mjs",
    "certs": "office-addin-dev-certs install",
    "sideload": "npx --yes office-addin-dev-settings sideload manifest.xml",
    "unsideload": "npx --yes office-addin-dev-settings unsideload manifest.xml",
    "validate": "npx --yes office-addin-manifest validate manifest.xml",
    "test": "node tools/test-lib.mjs && node tools/test-format.mjs && node tools/test-health.mjs && node tools/test-starter.mjs && node tools/test-bridge.mjs && node tools/test-pane.mjs",
    "test:unit": "node tools/test-lib.mjs",
    "test:format": "node tools/test-format.mjs",
    "test:bridge": "node tools/test-bridge.mjs",
    "test:pane": "node tools/test-pane.mjs",
    "test:e2e": "bash tools/smoke-test.sh",
    "test:health": "node tools/test-health.mjs",
    "test:starter": "node tools/test-starter.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "office-addin-dev-certs": "^1.13.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
